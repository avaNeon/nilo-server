<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neon.niloadmin.mapper.VideoCommentMapper">
    <resultMap id="base_result_map" type="com.neon.nilocommon.entity.po.VideoComment">
        <result column="comment_id" property="commentId"/>
        <result column="parent_comment_id" property="parentCommentId"/>
        <result column="video_id" property="videoId"/>
        <result column="video_user_id" property="videoUserId"/>
        <result column="content" property="content"/>
        <result column="img_paths" property="imgPaths"/>
        <result column="user_id" property="userId"/>
        <result column="reply_user_id" property="replyUserId"/>
        <result column="top_type" property="topType"/>
        <result column="post_time" property="postTime"/>
        <result column="upvote_count" property="upvoteCount"/>
        <result column="downvote_count" property="downvoteCount"/>
        <result column="reply_count" property="replyCount"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="base_column_list">
        v.comment_id,v.parent_comment_id,v.video_id,v.video_user_id,v.content,
        v.img_paths,v.user_id,v.reply_user_id,v.top_type,v.post_time,
        v.upvote_count,v.downvote_count,v.reply_count,v.deleted
    </sql>

    <sql id="base_condition_field">
        <if test="query.commentId != null">
            and v.comment_id = #{query.commentId}
        </if>
        <if test="query.parentCommentId != null">
            and v.parent_comment_id = #{query.parentCommentId}
        </if>
        <if test="query.videoId != null">
            and v.video_id = #{query.videoId}
        </if>
        <if test="query.videoUserId != null">
            and v.video_user_id = #{query.videoUserId}
        </if>
        <if test="query.content != null and query.content!=''">
            and v.content = #{query.content}
        </if>
        <if test="query.imgPaths != null and query.imgPaths!=''">
            and v.img_paths = #{query.imgPaths}
        </if>
        <if test="query.userId != null">
            and v.user_id = #{query.userId}
        </if>
        <if test="query.replyUserId != null">
            and v.reply_user_id = #{query.replyUserId}
        </if>
        <if test="query.topType != null">
            and v.top_type = #{query.topType}
        </if>
        <if test="query.postTime != null">
            and v.post_time = #{query.postTime}
        </if>
        <if test="query.upvoteCount != null">
            and v.upvote_count = #{query.upvoteCount}
        </if>
        <if test="query.downvoteCount != null">
            and v.downvote_count = #{query.downvoteCount}
        </if>
        <if test="query.deleted != null">
            and v.deleted = #{query.deleted}
        </if>
    </sql>

    <sql id="query_condition">
        <where>
            <include refid="base_condition_field"/>
            <if test="query.contentFuzzy!= null  and query.contentFuzzy!=''">
                and v.content like concat('%', #{query.contentFuzzy}, '%')
            </if>
            <if test="query.imgPathsFuzzy!= null  and query.imgPathsFuzzy!=''">
                and v.img_paths like concat('%', #{query.imgPathsFuzzy}, '%')
            </if>
            <if test="query.postTimeStart!= null and query.postTimeStart!=''">
                <![CDATA[ and v.post_time >= str_to_date(#{query.postTimeStart}, '%Y-%m-%d') ]]>
            </if>
            <if test="query.postTimeEnd!= null and query.postTimeEnd!=''">
                <![CDATA[ and v.post_time < date_add(str_to_date(#{query.postTimeEnd}, '%Y-%m-%d'), interval 1 day) ]]>
            </if>
        </where>
    </sql>

    <select id="selectList" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        FROM video_comment v
        <include refid="query_condition"/>
        <if test="query.orderBy!=null">
            order by ${query.orderBy}
        </if>
        <if test="query.pageCalculator!=null">
            limit #{query.pageCalculator.start},#{query.pageCalculator.size}
        </if>
    </select>

    <select id="selectCount" resultType="java.lang.Integer">
        SELECT count(1) FROM video_comment v
        <include refid="query_condition"/>
    </select>

    <insert id="insertBatch" parameterType="com.neon.nilocommon.entity.po.VideoComment">
        INSERT INTO video_comment(
        comment_id,
        parent_comment_id,
        video_id,
        video_user_id,
        content,
        img_paths,
        user_id,
        reply_user_id,
        top_type,
        post_time,
        upvote_count,
        downvote_count,
        reply_count,
        deleted
        )values
        <foreach collection="list" item="item" separator=",">
            (
            #{item.commentId},
            #{item.parentCommentId},
            #{item.videoId},
            #{item.videoUserId},
            #{item.content},
            #{item.imgPaths},
            #{item.userId},
            #{item.replyUserId},
            #{item.topType},
            #{item.postTime},
            #{item.upvoteCount},
            #{item.downvoteCount},
            IFNULL(#{item.replyCount}, 0),
            IFNULL(#{item.deleted}, 0)
            )
        </foreach>
    </insert>

    <delete id="deleteByParam">
        delete v from video_comment v
        <include refid="query_condition"/>
    </delete>

    <update id="safeDeleteByCommentId">
        update video_comment
        set deleted  = #{deletedType},
            top_type = 0
        where comment_id = #{commentId}
          and deleted = 0
    </update>

    <delete id="destroyByCommentIdList">
        delete
        from video_comment
        where comment_id IN
        <foreach collection="commentIdList" item="commentId" separator="," open="(" close=")">
            #{commentId}
        </foreach>
    </delete>

    <delete id="destroyDeletedByCommentIdList">
        delete
        from video_comment
        where deleted != 0
          and comment_id IN
        <foreach collection="commentIdList" item="commentId" separator="," open="(" close=")">
            #{commentId}
        </foreach>
    </delete>

    <select id="selectByCommentId" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        FROM video_comment v
        WHERE comment_id = #{commentId}
    </select>

    <select id="selectChildCommentIdList" resultType="java.lang.Long">
        SELECT comment_id
        FROM video_comment
        WHERE parent_comment_id IN
        <foreach collection="parentCommentIdList" item="parentCommentId" separator="," open="(" close=")">
            #{parentCommentId}
        </foreach>
    </select>

    <select id="selectDeletedCommentIdListByPostTimeRange" resultType="java.lang.Long">
        SELECT comment_id
        FROM video_comment
        WHERE deleted != 0
          and post_time >= #{postTimeStart}
          and post_time &lt; date_add(#{postTimeEnd}, interval 1 day)
    </select>

    <select id="selectDeletedCountByCommentIdList" resultType="java.lang.Integer">
        SELECT count(1)
        FROM video_comment
        WHERE deleted != 0
          and comment_id IN
        <foreach collection="commentIdList" item="commentId" separator="," open="(" close=")">
            #{commentId}
        </foreach>
    </select>
</mapper>
