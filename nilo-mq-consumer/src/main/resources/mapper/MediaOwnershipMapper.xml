            <if test="bean.createdTime != null">
                created_time = #{bean.createdTime},
            </if>
            <if test="bean.usedTime != null">
                used_time = #{bean.usedTime},
            </if>
        </set>
        <include refid="query_condition"/>
    </update>

    <!--多条件删除-->
    <delete id="deleteByParam">
        delete m from media_ownership m
        <include refid="query_condition"/>
    </delete>

    <!-- 根据ObjectKey修改-->
    <update id="updateByObjectKey" parameterType="com.neon.nilocommon.entity.po.MediaOwnership">
        UPDATE media_ownership
        <set>
            <if test="bean.bucket != null">
                bucket = #{bean.bucket},
            </if>
            <if test="bean.ownerId != null">
                owner_id = #{bean.ownerId},
            </if>
            <if test="bean.used != null">
                used = #{bean.used},
            </if>
            <if test="bean.createdTime != null">
                created_time = #{bean.createdTime},
            </if>
            <if test="bean.usedTime != null">
                used_time = #{bean.usedTime},
            </if>
        </set>
        where object_key=#{objectKey}
    </update>

    <!-- 根据ObjectKey删除-->
    <delete id="deleteByObjectKey">
        delete
        from media_ownership
        where object_key = #{objectKey}
    </delete>

    <!-- 根据ObjectKey批量删除-->
    <delete id="deleteBatchByObjectKey">
        delete
        from media_ownership
        where object_key in
        <foreach collection="objectKeys" item="objectKey" separator="," open="(" close=")">
            #{objectKey}
        </foreach>
    </delete>

    <!-- 根据PrimaryKey获取对象-->
    <select id="selectByObjectKey" resultMap="base_result_map">
        select
        <include refid="base_column_list"/>
        from media_ownership m where object_key=#{objectKey}
    </select>

    <!-- 根据Id修改-->
    <update id="updateById" parameterType="com.neon.nilocommon.entity.po.MediaOwnership">
        UPDATE media_ownership
        <set>
            <if test="bean.objectKey != null">
                object_key = #{bean.objectKey},
            </if>
            <if test="bean.bucket != null">
                bucket = #{bean.bucket},
            </if>
            <if test="bean.ownerId != null">
                owner_id = #{bean.ownerId},
            </if>
            <if test="bean.used != null">
                used = #{bean.used},
            </if>
            <if test="bean.createdTime != null">
                created_time = #{bean.createdTime},
            </if>
            <if test="bean.usedTime != null">
                used_time = #{bean.usedTime},
            </if>
        </set>
        where id=#{id}
    </update>

    <!-- 根据Id删除-->
    <delete id="deleteById">
        delete
        from media_ownership
        where id = #{id}
    </delete>

    <!-- 根据Id获取对象-->
    <select id="selectById" resultMap="base_result_map">
        select
        <include refid="base_column_list"/>
        from media_ownership m where id=#{id}
    </select>

    <update id="markAsUsed">
        UPDATE media_ownership
        SET used      = 1,
            used_time = #{usedTime}
        WHERE object_key = #{objectKey}
          AND owner_id = #{ownerId}
          AND used = 0
    </update>

    <update id="markAsUnused">
        UPDATE media_ownership
        SET used      = 0,
            used_time = NULL
        WHERE object_key = #{objectKey}
          AND owner_id = #{ownerId}
          AND used = 1
    </update>
</mapper>
