        used_time = VALUES(used_time)
    </insert>

    <!--多条件修改-->
    <update id="updateByParam" parameterType="com.neon.nilocommon.entity.query.MediaOwnershipQuery">
        UPDATE media_ownership m
        <set>
            <if test="bean.id != null">
                id = #{bean.id},
            </if>
            <if test="bean.objectKey != null">
                object_key = #{bean.objectKey},
            </if>
            <if test="bean.bucket != null">
