<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neon.nilocomment.mapper.VideoCommentMapper">
    <!--实体映射-->
    <resultMap id="base_result_map" type="com.neon.nilocommon.entity.po.VideoComment">
        <!--评论ID【对外展示】-->
        <result column="comment_id" property="commentId"/>
        <!--父级评论ID（为0表示顶层评论）-->
        <result column="parent_comment_id" property="parentCommentId"/>
        <!--视频ID-->
        <result column="video_id" property="videoId"/>
        <!--视频用户ID-->
        <result column="video_user_id" property="videoUserId"/>
        <!--回复内容-->
        <result column="content" property="content"/>
        <!--图片路径-->
        <result column="img_paths" property="imgPaths"/>
        <!--用户ID-->
        <result column="user_id" property="userId"/>
        <!--回复人ID-->
        <result column="reply_user_id" property="replyUserId"/>
        <!--0:未置顶 1:置顶-->
        <result column="top_type" property="topType"/>
        <!--发布时间-->
        <result column="post_time" property="postTime"/>
        <!--点赞数量-->
        <result column="upvote_count" property="upvoteCount"/>
        <!--点踩数量-->
        <result column="downvote_count" property="downvoteCount"/>
        <!--直接子评论数-->
        <result column="reply_count" property="replyCount"/>
        <!--逻辑删除标记：0-未删除 1-已删除-->
        <result column="deleted" property="deleted"/>
        <!--评论者昵称（冗余）-->
        <result column="nick_name" property="nickName"/>
        <!--评论者头像（冗余）-->
        <result column="avatar" property="avatar"/>
        <!--被回复者昵称（冗余）-->
        <result column="reply_nick_name" property="replyNickName"/>
        <!--视频标题（冗余）-->
        <result column="video_name" property="videoName"/>
        <!--视频封面（冗余）-->
        <result column="video_cover" property="videoCover"/>
    </resultMap>


    <!--
        VO 结果映射：包含评论本身所有展示字段 + 评论者信息（user_info）+ 当前用户操作记录（user_comment_action）。
        user_comment_action 使用 columnPrefix="uca_" 进行关联映射：
          - 登录且有操作记录 → currentUserAction 非 null，Service 层据此设置 isUpvoted/isDownvoted
          - 登录但无操作记录（LEFT JOIN 未命中）或未登录 → currentUserAction 为 null
    -->
    <resultMap id="vo_result_map" type="com.neon.nilocommon.entity.vo.comment.VideoCommentVO">
        <result column="comment_id" property="commentId"/>
        <result column="parent_comment_id" property="parentCommentId"/>
        <result column="content" property="content"/>
        <result column="img_paths" property="imgPaths"/>
        <result column="user_id" property="userId"/>
        <result column="top_type" property="topType"/>
        <result column="post_time" property="postTime"/>
        <result column="upvote_count" property="upvoteCount"/>
        <result column="downvote_count" property="downvoteCount"/>
        <result column="reply_count" property="replyCount"/>
        <result column="deleted" property="deleted"/>
        <result column="nick_name" property="nickName"/>
        <result column="avatar" property="avatar"/>
        <!--
            columnPrefix="uca_" 对应 SELECT 中的 uca.* AS uca_* 别名。
            若所有 uca_ 列均为 NULL（LEFT JOIN 未命中或未登录时传入 NULL 占位），MyBatis 自动将该属性置为 null。
        -->
        <association property="currentUserAction"
                     javaType="com.neon.nilocommon.entity.po.UserCommentAction"
                     columnPrefix="uca_">
            <result column="user_id" property="userId"/>
            <result column="comment_id" property="commentId"/>
            <result column="action_type" property="actionType"/>
        </association>
    </resultMap>

    <resultMap id="management_vo_result_map" type="com.neon.nilocommon.entity.vo.comment.CommentManagementVO">
        <result column="comment_id" property="commentId"/>
        <result column="user_id" property="userId"/>
