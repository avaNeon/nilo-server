    <update id="increaseByField">
        UPDATE video_info
        <set>
            ${field} = ${field} + ${increment}
            <if test="field == 'play_count'">
                ,last_play_time = now()
            </if>
        </set>
        <where>
            video_id = #{videoId}
        </where>
    </update>

    <update id="decreaseByField">
        UPDATE video_info
        <set>
            ${field} = ${field} - ${decrement}
            <if test="field == 'play_count'">
                ,last_play_time = now()
            </if>
        </set>
        <where>
            video_id = #{videoId}
        </where>
