<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neon.niloweb.mapper.UserMessageMapper">
    <!--实体映射-->
    <resultMap id="base_result_map" type="com.neon.nilocommon.entity.po.userMessage.UserMessage">
        <!--消息ID-->
        <result column="message_id" property="messageId"/>
        <!--用户ID-->
        <result column="user_id" property="userId"/>
        <!--相关视频ID-->
        <result column="video_id" property="videoId"/>
        <!--消息类型-->
        <result column="message_type" property="messageType"/>
        <!--发送者用户ID-->
        <result column="sender_user_id" property="senderUserId"/>
        <!--是否不可重复，null表示允许重复-->
        <result column="repeatable_type" property="repeatableType"/>
        <!--0:未读 1:已读-->
        <result column="read_type" property="readType"/>
        <!--创建时间-->
        <result column="create_time" property="createTime"/>
        <!--扩展信息（以JSON格式保存）-->
        <result column="extend_json" property="extendJson"/>
    </resultMap>

    <resultMap id="dto_result_map" type="com.neon.nilocommon.entity.dto.UserMessageDTO">
        <result column="message_id" property="messageId"/>
        <result column="video_id" property="videoId"/>
        <result column="message_type" property="messageType"/>
        <result column="sender_user_id" property="senderUserId"/>
        <result column="read_type" property="readType"/>
        <result column="create_time" property="createTime"/>
        <result column="extend_json"
                property="extendJson"
                typeHandler="com.neon.nilocommon.handler.ExtendJsonTypeHandler"/>
        <result column="nick_name" property="nickName"/>
        <result column="avatar" property="avatar"/>
        <result column="video_cover" property="videoCover"/>
        <result column="video_name" property="videoName"/>
    </resultMap>


    <!-- 通用查询结果列-->
    <sql id="base_column_list">
        u.message_id,u.user_id,u.video_id,u.message_type,u.sender_user_id,u.repeatable_type,
		 u.read_type,u.create_time,u.extend_json
    </sql>

    <!-- DTO查询结果列-->
    <sql id="dto_column_list">
        u.message_id,u.video_id,u.message_type,u.sender_user_id,
		 u.read_type,u.create_time,u.extend_json,ui.nick_name,ui.avatar,
		 COALESCE(v.video_cover, vu.video_cover) AS video_cover,
		 COALESCE(v.video_name, vu.video_name) AS video_name
    </sql>

    <sql id="base_condition_filed">
        <if test="query.messageId != null">
            and u.message_id = #{query.messageId}
        </if>
        <if test="query.userId != null">
            and u.user_id = #{query.userId}
        </if>
        <if test="query.videoId != null">
            and u.video_id = #{query.videoId}
        </if>
        <if test="query.messageType != null">
            and u.message_type = #{query.messageType}
        </if>
        <if test="query.senderUserId != null">
            and u.sender_user_id = #{query.senderUserId}
        </if>
        <if test="query.readType != null">
            and u.read_type = #{query.readType}
        </if>
        <if test="query.createTime != null and query.createTime!=''">
            <![CDATA[ and  u.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
        </if>
        <if test="query.extendJson != null and query.extendJson!=''">
            and u.extend_json = #{query.extendJson}
        </if>
    </sql>

    <!-- 通用查询条件列-->
    <sql id="query_condition">
        <bind name="extendJsonFuzzyEscaped" value="@com.neon.nilocommon.util.SqlUtil@escapeLike(query.extendJsonFuzzy)"/>
        <where>
            <include refid="base_condition_filed"/>
            <if test="query.createTimeStart!= null and query.createTimeStart!=''">
                <![CDATA[ and  u.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
            </if>
            <if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
                <![CDATA[ and  u.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
            </if>
            <if test="query.extendJsonFuzzy!= null  and query.extendJsonFuzzy!=''">
                and u.extend_json like concat('%', #{extendJsonFuzzyEscaped}, '%') ESCAPE '\\'
            </if>
        </where>
    </sql>

    <!-- 查询集合-->
    <select id="selectList" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        FROM user_message u
        <include refid="query_condition"/>
        <if test="query.orderBy!=null">
            order by ${query.orderBy}
        </if>
        <if test="query.pageCalculator!=null">
            limit #{query.pageCalculator.start},#{query.pageCalculator.size}
        </if>
    </select>

    <!-- 查询数量-->
    <select id="selectCount" resultType="java.lang.Integer">
        SELECT count(1) FROM user_message u
        <include refid="query_condition"/>
    </select>

