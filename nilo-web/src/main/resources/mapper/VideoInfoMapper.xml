    <select id="selectCountVideoInfoByUserIdExcludingSeriesId" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM video_info v
                 LEFT JOIN video_series_video vsv ON v.video_id = vsv.video_id
        WHERE v.user_id = #{userId}
          AND vsv.series_id != #{seriesId}
        ORDER BY v.last_update_time DESC
    </select>

    <select id="selectVideoInfoByUserIdExcludingSeriesId" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        FROM video_info v LEFT JOIN video_series_video vsv ON v.video_id = vsv.video_id
        WHERE v.user_id = #{userId} AND vsv.series_id != #{seriesId}
        ORDER BY v.last_update_time DESC
        LIMIT #{start},#{pageSize}
    </select>

    <select id="selectVideoInfoBySeriesId" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        FROM video_series_video vsv LEFT JOIN video_info v ON vsv.video_id = v. video_id
        WHERE vsv.series_id = #{seriesId}
        ORDER BY vsv.sort_index
        LIMIT #{start},#{pageSize}
    </select>

    <select id="selectVideoInfoBySeriesIdBatch" resultType="com.neon.nilocommon.entity.vo.VideoSeriesVideoVO">
        SELECT
        <include refid="video_series_column_list"/>,vsv.series_id
        FROM (
        SELECT series_id, video_id, ROW_NUMBER() OVER (
        PARTITION BY series_id
        ORDER BY sort_index, video_id
        ) AS rn
        FROM video_series_video
        WHERE series_id IN
        <foreach collection="seriesIdList" item="seriesId" separator="," open="(" close=")">
            #{seriesId}
        </foreach>
        ) vsv
        JOIN video_info v ON vsv.video_id = v.video_id
        <if test="pageSize!=null">
            WHERE vsv.rn &lt;= #{pageSize}
        </if>
        ORDER BY vsv.series_id,vsv.rn
    </select>
