<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neon.niloweb.mapper.VideoCommentMapper">
    <!--实体映射-->
    <resultMap id="base_result_map" type="com.neon.nilocommon.entity.po.VideoComment">
        <!--评论ID【对外展示】-->
        <result column="comment_id" property="commentId"/>
        <!--父级评论ID（为0表示顶层评论）-->
        <result column="parent_comment_id" property="parentCommentId"/>
        <!--视频ID-->
        <result column="video_id" property="videoId"/>
        <!--视频用户ID-->
        <result column="video_user_id" property="videoUserId"/>
        <!--回复内容-->
        <result column="content" property="content"/>
        <!--图片路径-->
        <result column="img_paths" property="imgPaths"/>
        <!--用户ID-->
        <result column="user_id" property="userId"/>
        <!--回复人ID-->
        <result column="reply_user_id" property="replyUserId"/>
        <!--0:未置顶 1:置顶-->
        <result column="top_type" property="topType"/>
        <!--发布时间-->
        <result column="post_time" property="postTime"/>
        <!--点赞数量-->
        <result column="upvote_count" property="upvoteCount"/>
        <!--点踩数量-->
        <result column="downvote_count" property="downvoteCount"/>
        <!--直接子评论数-->
        <result column="reply_count" property="replyCount"/>
        <!--逻辑删除标记：0-未删除 1-已删除-->
        <result column="deleted" property="deleted"/>
    </resultMap>


    <!--
        VO 结果映射：包含评论本身所有展示字段 + 评论者信息（user_info）+ 当前用户操作记录（user_comment_action）。
        user_comment_action 使用 columnPrefix="uca_" 进行关联映射：
          - 登录且有操作记录 → currentUserAction 非 null，Service 层据此设置 isUpvoted/isDownvoted
          - 登录但无操作记录（LEFT JOIN 未命中）或未登录 → currentUserAction 为 null
    -->
    <resultMap id="vo_result_map" type="com.neon.nilocommon.entity.vo.comment.VideoCommentVO">
        <result column="comment_id" property="commentId"/>
        <result column="parent_comment_id" property="parentCommentId"/>
        <result column="content" property="content"/>
        <result column="img_paths" property="imgPaths"/>
        <result column="user_id" property="userId"/>
        <result column="top_type" property="topType"/>
        <result column="post_time" property="postTime"/>
        <result column="upvote_count" property="upvoteCount"/>
        <result column="downvote_count" property="downvoteCount"/>
        <result column="reply_count" property="replyCount"/>
        <result column="deleted" property="deleted"/>
        <result column="nick_name" property="nickName"/>
        <result column="avatar" property="avatar"/>
        <!--
            columnPrefix="uca_" 对应 SELECT 中的 uca.* AS uca_* 别名。
            若所有 uca_ 列均为 NULL（LEFT JOIN 未命中或未登录时传入 NULL 占位），MyBatis 自动将该属性置为 null。
        -->
        <association property="currentUserAction"
                     javaType="com.neon.nilocommon.entity.po.UserCommentAction"
                     columnPrefix="uca_">
            <result column="user_id" property="userId"/>
            <result column="comment_id" property="commentId"/>
            <result column="action_type" property="actionType"/>
        </association>
    </resultMap>

    <resultMap id="management_vo_result_map" type="com.neon.nilocommon.entity.vo.comment.CommentManagementVO">
        <result column="comment_id" property="commentId"/>
        <result column="user_id" property="userId"/>
        <result column="reply_user_id" property="replyUserId"/>
        <result column="content" property="content"/>
        <result column="img_paths" property="imgPaths"/>
        <result column="post_time" property="postTime"/>
        <result column="video_id" property="videoId"/>
        <result column="video_name" property="videoName"/>
        <result column="video_cover" property="videoCover"/>
        <result column="nick_name" property="nickName"/>
        <result column="reply_nick_name" property="replyNickName"/>
        <result column="avatar" property="avatar"/>
    </resultMap>

    <!-- 通用查询结果列-->
    <sql id="base_column_list">
        v.comment_id,v.parent_comment_id,v.video_id,v.video_user_id,v.content,
		 v.img_paths,v.user_id,v.reply_user_id,v.top_type,v.post_time,
		 v.upvote_count,v.downvote_count,v.reply_count,v.deleted
    </sql>

    <sql id="base_condition_filed">
        <if test="query.commentId != null">
            and v.comment_id = #{query.commentId}
        </if>
        <if test="query.parentCommentId != null">
            and v.parent_comment_id = #{query.parentCommentId}
        </if>
        <if test="query.videoId != null">
            and v.video_id = #{query.videoId}
        </if>
        <if test="query.videoUserId != null">
            and v.video_user_id = #{query.videoUserId}
        </if>
        <if test="query.content != null and query.content!=''">
            and v.content = #{query.content}
        </if>
        <if test="query.imgPaths != null and query.imgPaths!=''">
            and v.img_paths = #{query.imgPaths}
        </if>
        <if test="query.userId != null">
            and v.user_id = #{query.userId}
        </if>
        <if test="query.replyUserId != null">
            and v.reply_user_id = #{query.replyUserId}
        </if>
        <if test="query.topType != null">
            and v.top_type = #{query.topType}
        </if>
        <if test="query.postTime != null and query.postTime!=''">
            <![CDATA[ and  v.post_time=str_to_date(#{query.postTime}, '%Y-%m-%d') ]]>
        </if>
        <if test="query.upvoteCount != null">
            and v.upvote_count = #{query.upvoteCount}
        </if>
        <if test="query.downvoteCount != null">
            and v.downvote_count = #{query.downvoteCount}
        </if>
        <if test="query.deleted != null">
            and v.deleted = #{query.deleted}
        </if>
    </sql>

    <!-- 通用查询条件列-->
    <sql id="query_condition">
        <bind name="contentFuzzyEscaped" value="@com.neon.nilocommon.util.SqlUtil@escapeLike(query.contentFuzzy)"/>
        <bind name="imgPathsFuzzyEscaped" value="@com.neon.nilocommon.util.SqlUtil@escapeLike(query.imgPathsFuzzy)"/>
        <where>
            <include refid="base_condition_filed"/>
            <if test="query.contentFuzzy!= null  and query.contentFuzzy!=''">
                and v.content like concat('%', #{contentFuzzyEscaped}, '%') ESCAPE '\\'
            </if>
            <if test="query.imgPathsFuzzy!= null  and query.imgPathsFuzzy!=''">
                and v.img_paths like concat('%', #{imgPathsFuzzyEscaped}, '%') ESCAPE '\\'
            </if>
            <if test="query.postTimeStart!= null and query.postTimeStart!=''">
                <![CDATA[ and  v.post_time>=str_to_date(#{query.postTimeStart}, '%Y-%m-%d') ]]>
            </if>
            <if test="query.postTimeEnd!= null and query.postTimeEnd!=''">
                <![CDATA[ and  v.post_time< date_sub(str_to_date(#{query.postTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
            </if>
        </where>
    </sql>

    <!-- 查询集合-->
    <select id="selectList" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        FROM video_comment v
        <include refid="query_condition"/>
