            </if>
        </trim>
    </insert>

    <!-- 添加 （批量插入）-->
    <insert id="insertBatch" parameterType="com.neon.nilocommon.entity.po.MediaOwnership">
        INSERT INTO media_ownership(
        object_key,
        bucket,
        owner_id,
        used,
        created_time,
        used_time
        )values
        <foreach collection="list" item="item" separator=",">
