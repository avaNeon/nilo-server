    <!-- 通用查询结果列-->
    <sql id="base_column_list">
        v.comment_id,v.parent_comment_id,v.video_id,v.video_user_id,v.content,
		 v.img_paths,v.user_id,v.reply_user_id,v.top_type,v.post_time,
		 v.upvote_count,v.downvote_count,v.reply_count,v.deleted,
		 v.nick_name,v.avatar,v.reply_nick_name,v.video_name,v.video_cover
    </sql>

    <sql id="base_condition_filed">
        <if test="query.commentId != null">
            and v.comment_id = #{query.commentId}
        </if>
        <if test="query.parentCommentId != null">
            and v.parent_comment_id = #{query.parentCommentId}
        </if>
        <if test="query.videoId != null">
            and v.video_id = #{query.videoId}
        </if>
        <if test="query.videoUserId != null">
            and v.video_user_id = #{query.videoUserId}
        </if>
        <if test="query.content != null and query.content!=''">
            and v.content = #{query.content}
        </if>
        <if test="query.imgPaths != null and query.imgPaths!=''">
            and v.img_paths = #{query.imgPaths}
        </if>
        <if test="query.userId != null">
            and v.user_id = #{query.userId}
        </if>
        <if test="query.replyUserId != null">
            and v.reply_user_id = #{query.replyUserId}
        </if>
        <if test="query.topType != null">
            and v.top_type = #{query.topType}
        </if>
        <if test="query.postTime != null and query.postTime!=''">
            <![CDATA[ and  v.post_time=str_to_date(#{query.postTime}, '%Y-%m-%d') ]]>
        </if>
        <if test="query.upvoteCount != null">
            and v.upvote_count = #{query.upvoteCount}
        </if>
        <if test="query.downvoteCount != null">
            and v.downvote_count = #{query.downvoteCount}
        </if>
        <if test="query.deleted != null">
            and v.deleted = #{query.deleted}
        </if>
        <if test="query.nickName != null and query.nickName!=''">
            and v.nick_name = #{query.nickName}
        </if>
        <if test="query.avatar != null and query.avatar!=''">
            and v.avatar = #{query.avatar}
        </if>
        <if test="query.replyNickName != null and query.replyNickName!=''">
            and v.reply_nick_name = #{query.replyNickName}
        </if>
        <if test="query.videoName != null and query.videoName!=''">
            and v.video_name = #{query.videoName}
        </if>
        <if test="query.videoCover != null and query.videoCover!=''">
            and v.video_cover = #{query.videoCover}
        </if>
    </sql>

    <!-- 通用查询条件列-->
    <sql id="query_condition">
        <bind name="contentFuzzyEscaped" value="@com.neon.nilocommon.util.SqlUtil@escapeLike(query.contentFuzzy)"/>
        <bind name="imgPathsFuzzyEscaped" value="@com.neon.nilocommon.util.SqlUtil@escapeLike(query.imgPathsFuzzy)"/>
        <bind name="nickNameFuzzyEscaped" value="@com.neon.nilocommon.util.SqlUtil@escapeLike(query.nickNameFuzzy)"/>
        <bind name="avatarFuzzyEscaped" value="@com.neon.nilocommon.util.SqlUtil@escapeLike(query.avatarFuzzy)"/>
        <bind name="replyNickNameFuzzyEscaped"
              value="@com.neon.nilocommon.util.SqlUtil@escapeLike(query.replyNickNameFuzzy)"/>
        <bind name="videoNameFuzzyEscaped" value="@com.neon.nilocommon.util.SqlUtil@escapeLike(query.videoNameFuzzy)"/>
        <bind name="videoCoverFuzzyEscaped"
              value="@com.neon.nilocommon.util.SqlUtil@escapeLike(query.videoCoverFuzzy)"/>
        <where>
            <include refid="base_condition_filed"/>
            <if test="query.contentFuzzy!= null  and query.contentFuzzy!=''">
                and v.content like concat('%', #{contentFuzzyEscaped}, '%') ESCAPE '\\'
            </if>
            <if test="query.imgPathsFuzzy!= null  and query.imgPathsFuzzy!=''">
                and v.img_paths like concat('%', #{imgPathsFuzzyEscaped}, '%') ESCAPE '\\'
            </if>
            <if test="query.nickNameFuzzy!= null  and query.nickNameFuzzy!=''">
                and v.nick_name like concat('%', #{nickNameFuzzyEscaped}, '%') ESCAPE '\\'
            </if>
            <if test="query.avatarFuzzy!= null  and query.avatarFuzzy!=''">
                and v.avatar like concat('%', #{avatarFuzzyEscaped}, '%') ESCAPE '\\'
            </if>
            <if test="query.replyNickNameFuzzy!= null  and query.replyNickNameFuzzy!=''">
                and v.reply_nick_name like concat('%', #{replyNickNameFuzzyEscaped}, '%') ESCAPE '\\'
            </if>
            <if test="query.videoNameFuzzy!= null  and query.videoNameFuzzy!=''">
                and v.video_name like concat('%', #{videoNameFuzzyEscaped}, '%') ESCAPE '\\'
            </if>
            <if test="query.videoCoverFuzzy!= null  and query.videoCoverFuzzy!=''">
                and v.video_cover like concat('%', #{videoCoverFuzzyEscaped}, '%') ESCAPE '\\'
            </if>
            <if test="query.postTimeStart!= null and query.postTimeStart!=''">
                <![CDATA[ and  v.post_time>=str_to_date(#{query.postTimeStart}, '%Y-%m-%d') ]]>
            </if>
            <if test="query.postTimeEnd!= null and query.postTimeEnd!=''">
                <![CDATA[ and  v.post_time< date_sub(str_to_date(#{query.postTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
            </if>
        </where>
    </sql>

    <!-- 查询集合-->
    <select id="selectList" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        FROM video_comment v
        <include refid="query_condition"/>
        <if test="query.orderBy!=null">
            order by ${query.orderBy}
        </if>
        <if test="query.pageCalculator!=null">
            limit #{query.pageCalculator.start},#{query.pageCalculator.size}
        </if>
    </select>

    <!-- 查询数量-->
    <select id="selectCount" resultType="java.lang.Integer">
        SELECT count(1) FROM video_comment v
        <include refid="query_condition"/>
    </select>

