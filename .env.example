# 本文件为环境变量模板
# 复制为 .env 并填入真实值后，.env 不会被提交（见 .gitignore）。
# 运行各服务前，需保证以下变量已注入到进程环境（例如通过 IDE 的 EnvFile 插件指向本文件，
# 或在启动前 `source .env` / 在系统环境变量中配置）。
#
# 这里只放连接 Nacos 用的配置；其余配置（密钥、各中间件地址等）都在 Nacos 的 nilo-common.yaml 里。

# NACOS_SERVER_ADDR 可选，不设置则使用 yaml 中的默认值（本地 127.0.0.1:8848）
NACOS_SERVER_ADDR=
# NACOS_NAMESPACE 必填，yaml 中已无默认值，不设置服务无法启动
NACOS_NAMESPACE=

# Nacos 开了登录验证时填；没开可以留空
NACOS_USERNAME=
NACOS_PASSWORD=
