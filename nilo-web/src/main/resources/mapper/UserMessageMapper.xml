        delete
        from user_message
        where message_id = #{messageId}
    </delete>

    <!-- 根据PrimaryKey获取对象-->
    <select id="selectByMessageId" resultMap="base_result_map">
        select
        <include refid="base_column_list"/>
        from user_message u where message_id=#{messageId}
    </select>

    <insert id="insertIfNotExists">
        INSERT IGNORE INTO user_message (message_id,
                                         user_id,
                                         video_id,
                                         message_type,
                                         sender_user_id,
                                         repeatable_type,
                                         read_type,
                                         create_time,
                                         extend_json)
        VALUES (#{userMessage.messageId},
                #{userMessage.userId},
                #{userMessage.videoId},
                #{userMessage.messageType},
                #{userMessage.senderUserId},
                #{userMessage.repeatableType},
                #{userMessage.readType},
                #{userMessage.createTime},
                #{userMessage.extendJson})
    </insert>

    <select id="selectUncheckedMessageCount" resultType="com.neon.nilocommon.entity.dto.UserMessageCount">
        SELECT COUNT(CASE WHEN message_type = 1 THEN 1 END) AS systemMessageCount,
               COUNT(CASE WHEN message_type = 2 THEN 1 END) AS likeMessageCount,
               COUNT(CASE WHEN message_type = 3 THEN 1 END) AS collectMessageCount,
               COUNT(CASE WHEN message_type = 4 THEN 1 END) AS commentMessageCount
        FROM user_message
        WHERE user_id = #{userId}
          AND read_type = 0
    </select>

    <update id="checkAllMessages">
        UPDATE user_message
        SET read_type = 1
        WHERE user_id = #{userId}
          AND read_type = 0
          AND message_type = #{messageType}
    </update>

    <update id="checkMessage">
        UPDATE user_message
        SET read_type = 1
        WHERE user_id = #{userId}
          AND message_id = #{messageId}
          AND read_type = 0
    </update>

    <delete id="deleteByUserIdAndMessageId">
        DELETE
        FROM user_message
        WHERE user_id = #{userId}
          AND message_id = #{messageId}
    </delete>

    <select id="selectDtoList" resultMap="dto_result_map">
        SELECT
        <include refid="dto_column_list"/>
        FROM user_message u LEFT JOIN user_info ui ON u.sender_user_id = ui.user_id
        LEFT JOIN video_info v ON u.video_id = v.video_id
        LEFT JOIN video_info_upload vu ON u.video_id = vu.video_id
        <include refid="query_condition"/>
        <if test="query.orderBy!=null">
            order by ${query.orderBy}
        </if>
        <if test="query.pageCalculator!=null">
            limit #{query.pageCalculator.start},#{query.pageCalculator.size}
        </if>
    </select>
