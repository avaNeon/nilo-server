    <resultMap id="base_result_map" type="com.neon.nilocommon.entity.po.VideoCommentArchive">
        <!--评论ID【对外展示】-->
        <result column="comment_id" property="commentId"/>
        <!--父级评论ID（为0表示顶层评论）-->
        <result column="parent_comment_id" property="parentCommentId"/>
        <!--视频ID-->
        <result column="video_id" property="videoId"/>
        <!--视频用户ID-->
        <result column="video_user_id" property="videoUserId"/>
        <!--回复内容-->
        <result column="content" property="content"/>
        <!--图片路径-->
        <result column="img_paths" property="imgPaths"/>
        <!--用户ID-->
        <result column="user_id" property="userId"/>
        <!--回复人ID-->
        <result column="reply_user_id" property="replyUserId"/>
        <!--0:未置顶 1:置顶-->
        <result column="top_type" property="topType"/>
        <!--发布时间-->
        <result column="post_time" property="postTime"/>
        <!--点赞数量-->
        <result column="upvote_count" property="upvoteCount"/>
        <!--点踩数量-->
        <result column="downvote_count" property="downvoteCount"/>
        <!--（下一层）回复数量-->
        <result column="reply_count" property="replyCount"/>
        <!--删除标记（0：未删除，1：已删除）-->
        <result column="deleted" property="deleted"/>
        <!--评论者昵称（冗余）-->
        <result column="nick_name" property="nickName"/>
        <!--评论者头像（冗余）-->
        <result column="avatar" property="avatar"/>
        <!--被回复者昵称（冗余）-->
        <result column="reply_nick_name" property="replyNickName"/>
        <!--视频标题（冗余）-->
        <result column="video_name" property="videoName"/>
        <!--视频封面（冗余）-->
        <result column="video_cover" property="videoCover"/>
    </resultMap>


    <!-- 通用查询结果列-->
    <sql id="base_column_list">
        v.comment_id,v.parent_comment_id,v.video_id,v.video_user_id,v.content,
		 v.img_paths,v.user_id,v.reply_user_id,v.top_type,v.post_time,
		 v.upvote_count,v.downvote_count,v.reply_count,v.deleted,
		 v.nick_name,v.avatar,v.reply_nick_name,v.video_name,v.video_cover
    </sql>

    <sql id="base_condition_filed">
        <if test="query.commentId != null">
            and v.comment_id = #{query.commentId}
        </if>
        <if test="query.parentCommentId != null">
            and v.parent_comment_id = #{query.parentCommentId}
        </if>
        <if test="query.videoId != null">
            and v.video_id = #{query.videoId}
        </if>
        <if test="query.videoUserId != null">
            and v.video_user_id = #{query.videoUserId}
        </if>
        <if test="query.content != null and query.content!=''">
            and v.content = #{query.content}
        </if>
        <if test="query.imgPaths != null and query.imgPaths!=''">
            and v.img_paths = #{query.imgPaths}
        </if>
        <if test="query.userId != null">
            and v.user_id = #{query.userId}
        </if>
        <if test="query.replyUserId != null">
            and v.reply_user_id = #{query.replyUserId}
        </if>
        <if test="query.topType != null">
            and v.top_type = #{query.topType}
        </if>
        <if test="query.postTime != null and query.postTime!=''">
            <![CDATA[ and  v.post_time=str_to_date(#{query.postTime}, '%Y-%m-%d') ]]>
        </if>
        <if test="query.upvoteCount != null">
            and v.upvote_count = #{query.upvoteCount}
        </if>
        <if test="query.downvoteCount != null">
