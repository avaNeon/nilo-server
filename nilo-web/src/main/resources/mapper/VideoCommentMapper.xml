    <!--
        窗口函数版（旧）：

        每个父节点只取前 limitPerParent 条子评论（per-parent top-K）。
        用 ROW_NUMBER() OVER (PARTITION BY parent_comment_id ORDER BY post_time ASC) 实现。
        是否还有更多子评论由调用方通过 replyCount > limitPerParent 判断。

        JOIN 策略（旧）：
          - INNER JOIN user_info：评论一定有评论者，获取 nick_name / avatar（user_id 为主键，等值查找极快）
          - LEFT JOIN user_comment_action（仅 userId != null 时）：
              索引覆盖（user_id, comment_id, action_type），只取这三列，无需回表。
              userId == null 时跳过 JOIN，并在 SELECT 中以 NULL 占位，确保 resultMap 列名一致。

        LATERAL 版（现在的版本）：per-parent top-K 子评论查询

        对 parents 派生表的每一行独立执行带 LIMIT 的 range seek，
        实现 early termination，避免扫描每个父评论下的全部子评论。

        parents 派生表用 UNION ALL 展开 parentIdList：
            - index=0 的首项必须带 AS cid，后续项不需要（UNION ALL 列名由第一个 SELECT 决定）
            - MyBatis 用 <choose> + index 判断控制这一点

        JOIN 策略同原版：
            - INNER JOIN user_info：评论必有评论者，主键等值查找
            - LEFT JOIN user_comment_action（仅 userId != null 时）：覆盖索引，无需回表
    -->
    <select id="selectByParentIdList" resultMap="vo_result_map">
        SELECT subs.comment_id,
        subs.parent_comment_id,
        subs.content,
        subs.img_paths,
        subs.user_id,
        subs.nick_name,
        subs.avatar,
        subs.top_type,
        subs.post_time,
        subs.upvote_count,
        subs.downvote_count,
        subs.reply_count,
        subs.deleted,
        <if test="userId != null">
            , uca.user_id AS uca_user_id
            , uca.comment_id AS uca_comment_id
            , uca.action_type AS uca_action_type
        </if>
        <if test="userId == null">
            , NULL AS uca_user_id
            , NULL AS uca_comment_id
            , NULL AS uca_action_type
        </if>
        FROM (
        <foreach collection="parentIdList" item="id" index="i" separator=" UNION ALL ">
            <choose>
                <when test="i == 0">
                    SELECT #{id} AS cid
                </when>
                <otherwise>
                    SELECT #{id}
                </otherwise>
            </choose>
        </foreach>
        ) parents
        JOIN LATERAL (
        SELECT v.comment_id,
        v.parent_comment_id,
        v.content,
        v.img_paths,
        v.user_id,
        v.nick_name,
        v.avatar,
        v.top_type,
        v.post_time,
        v.upvote_count,
        v.downvote_count,
        v.reply_count,
        v.deleted
        FROM video_comment v
        WHERE v.video_id = #{videoId}
        AND v.parent_comment_id = parents.cid
        AND v.top_type = 0
        ORDER BY v.post_time
        LIMIT #{limitPerParent}
        ) subs
        <if test="userId != null">
            LEFT JOIN user_comment_action uca
            ON uca.user_id = #{userId}
            AND uca.comment_id = subs.comment_id
        </if>
    </select>

    <!--
        分页查询评论列表 VO（等价于 selectList，但额外 JOIN user_info 和可选 LEFT JOIN user_comment_action）。
        JOIN 策略与 selectByParentIdList 相同。
    -->
    <select id="selectListVO" resultMap="vo_result_map">
        SELECT
        v.comment_id,
        v.parent_comment_id,
        v.content,
        v.img_paths,
        v.user_id,
        v.nick_name,
        v.avatar,
        v.top_type,
        v.post_time,
        v.upvote_count,
        v.downvote_count,
        v.reply_count,
        v.deleted
        <if test="userId != null">
            , uca.user_id AS uca_user_id
            , uca.comment_id AS uca_comment_id
            , uca.action_type AS uca_action_type
        </if>
        <if test="userId == null">
            , NULL AS uca_user_id
            , NULL AS uca_comment_id
            , NULL AS uca_action_type
        </if>
        FROM video_comment v
        <if test="userId != null">
            LEFT JOIN user_comment_action uca
            ON uca.user_id = #{userId} AND uca.comment_id = v.comment_id
        </if>
        <include refid="query_condition"/>
        <if test="query.orderBy!=null">
            order by ${query.orderBy}
        </if>
        <if test="query.pageCalculator!=null">
            limit #{query.pageCalculator.start},#{query.pageCalculator.size}
        </if>
    </select>

    <select id="selectListAllTopKindsVO" resultMap="vo_result_map">
        SELECT
        v.comment_id,
        v.parent_comment_id,
        v.content,
        v.img_paths,
        v.user_id,
        v.nick_name,
        v.avatar,
        v.top_type,
        v.post_time,
        v.upvote_count,
        v.downvote_count,
        v.reply_count,
        v.deleted
        <if test="userId != null">
            , uca.user_id AS uca_user_id
            , uca.comment_id AS uca_comment_id
            , uca.action_type AS uca_action_type
        </if>
        <if test="userId == null">
            , NULL AS uca_user_id
            , NULL AS uca_comment_id
            , NULL AS uca_action_type
        </if>
        FROM video_comment v
        <if test="userId != null">
            LEFT JOIN user_comment_action uca
            ON uca.user_id = #{userId} AND uca.comment_id = v.comment_id
        </if>
        WHERE v.parent_comment_id = #{parentCommentId} AND v.video_id = #{videoId}
        ORDER BY v.top_type DESC ,${orderBy}
        LIMIT #{pageCalculator.start},#{pageCalculator.size}
    </select>

    <!-- 发布回复时将父评论的直接子评论数 +1 -->
    <update id="increaseReplyCount">
        UPDATE video_comment
        <set>
            reply_count = reply_count + 1
        </set>
        <where>
            comment_id = #{commentId}
        </where>
    </update>

    <update id="increaseUpvoteCount">
        UPDATE video_comment
        <set>
            upvote_count = upvote_count + 1
        </set>
        <where>
            comment_id = #{commentId}
        </where>
    </update>

    <update id="decreaseUpVoteCount">
        UPDATE video_comment
        <set>
            upvote_count = upvote_count - 1
        </set>
        <where>
            comment_id = #{commentId}
        </where>
    </update>

    <update id="increaseDownvoteCount">
        UPDATE video_comment
        <set>
            downvote_count = downvote_count + 1
        </set>
        <where>
            comment_id = #{commentId}
        </where>
    </update>

    <update id="decreaseDownvoteCount">
        UPDATE video_comment
        <set>
            downvote_count = downvote_count - 1
        </set>
        <where>
            comment_id = #{commentId}
        </where>
    </update>

    <select id="selectUpvoteCountByUserId" resultType="java.lang.Long">
        SELECT IFNULL(SUM(upvote_count), 0)
        FROM video_comment
        WHERE user_id = #{userId}
          AND deleted = 0
    </select>

    <select id="selectCommentManagementVOCount" resultType="long">
        <bind name="nameFuzzyEscaped" value="@com.neon.nilocommon.util.SqlUtil@escapeLike(nameFuzzy)"/>
        SELECT COUNT(1)
        FROM video_comment vc
        LEFT JOIN video_info v ON v.video_id = vc.video_id
        LEFT JOIN user_info u1 ON vc.user_id = u1.user_id
        LEFT JOIN user_info u2 ON vc.reply_user_id = u2.user_id
        <where>
            vc.deleted = 0
            <if test="userId != null">
                AND vc.video_user_id = #{userId}
            </if>
            <if test="videoId != null">
                AND vc.video_id = #{videoId}
            </if>
            <if test="nameFuzzy != null and nameFuzzy != ''">
                AND v.video_name LIKE CONCAT('%',#{nameFuzzyEscaped},'%') ESCAPE '\\'
            </if>
        </where>
    </select>

    <select id="selectCommentManagementVO" resultMap="management_vo_result_map">
        <bind name="nameFuzzyEscaped" value="@com.neon.nilocommon.util.SqlUtil@escapeLike(nameFuzzy)"/>
        SELECT vc.comment_id,
        vc.user_id,
        vc.reply_user_id,
        vc.content,
        vc.img_paths,
        vc.post_time,
        vc.video_id,
        v.video_name,
        v.video_cover,
        u1.nick_name as nick_name,
        u2.nick_name as reply_nick_name,
        u1.avatar
        FROM video_comment vc
        LEFT JOIN video_info v ON v.video_id = vc.video_id
        LEFT JOIN user_info u1 ON vc.user_id = u1.user_id
        LEFT JOIN user_info u2 ON vc.reply_user_id = u2.user_id
        <where>
            vc.deleted = 0
            <if test="userId != null">
                AND vc.video_user_id = #{userId}
            </if>
            <if test="videoId != null">
                AND vc.video_id = #{videoId}
            </if>
            <if test="nameFuzzy != null and nameFuzzy != ''">
                AND v.video_name LIKE CONCAT('%',#{nameFuzzyEscaped},'%') ESCAPE '\\'
            </if>
        </where>
        ORDER BY vc.post_time DESC
        LIMIT #{start},#{pageSize}
    </select>
</mapper>
